# CompanyOS Environment Configuration
# Copy this file to .env and fill in your values

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Choose: "gemini" or "openai"
LLM_PROVIDER=gemini

# Your LLM API key (never commit this file)
LLM_API_KEY=your_api_key_here

# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Set to "true" to bypass all LLM calls and use a pre-built BeanRush Coffee response.
# Perfect for demos when API is unavailable or to save API credits.
DEMO_MODE=true

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000

# ─── Gemini Model ────────────────────────────────────────────────────────────
# Recommended free-tier model: gemini-2.0-flash-exp
GEMINI_MODEL=gemini-2.0-flash-exp

# ─── OpenAI Model ────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o

# ─── Groq Model ────────────────────────────────────────────────────────────
# Fast free model for multi-agent orchestration
GROQ_MODEL=llama-3.1-8b-instant

# ─── Search Tool (Step 2: Research Agent) ─────────────────────────────────
# Required for real web searches in the Research Agent.
# Free tier: 1,000 searches/month. No credit card needed.
# Sign up at: https://app.tavily.com/sign-up
TAVILY_API_KEY=your_tavily_key_here
